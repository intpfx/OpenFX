{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "perry/system": "./src/perry-system-stub.ts",
    "perry/ui": "./src/perry-ui-stub.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-run=deno tests",
    "check": "deno fmt --check src tests tools README.md deno.json && deno lint src tests tools && deno test --allow-read --allow-write --allow-net --allow-run=deno tests",
    "app": "deno run -A tools/build-macos-app.ts",
    "app-smoke": "deno run -A tools/desktop-app-smoke.ts"
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false
  }
}
