new file mode 100644
index 0000000..086deca
--- /dev/null
+++ b/crates/perry-ui-macos/src/widgets/video.rs
@@ -0,0 +1,83 @@
+//! Native video playback backed by AVPlayerView.
+
+use objc2::msg_send;
+use objc2::rc::Retained;
+use objc2::runtime::{AnyClass, AnyObject};
+use objc2_app_kit::NSView;
+use objc2_foundation::NSString;
+
+use super::image::str_from_header;
+
+pub fn create_file(path_ptr: *const u8) -> i64 {
+    let path = str_from_header(path_ptr);
+    if path.is_empty() {
+        return 0;
+    }
+
+    unsafe {
+        let Some(url_class) = AnyClass::get(c"NSURL") else {
+            return 0;
+        };
+        let Some(player_class) = AnyClass::get(c"AVPlayer") else {
+            return 0;
+        };
+        let Some(player_view_class) = AnyClass::get(c"AVPlayerView") else {
+            return 0;
+        };
+
+        let ns_path = NSString::from_str(path);
+        let url: *mut AnyObject = msg_send![url_class, fileURLWithPath: &*ns_path];
+        if url.is_null() {
+            return 0;
+        }
+        let player: *mut AnyObject = msg_send![player_class, playerWithURL: url];
+        if player.is_null() {
+            return 0;
+        }
+
+        let allocated: *mut AnyObject = msg_send![player_view_class, alloc];
+        let frame = objc2_core_foundation::CGRect::new(
+            objc2_core_foundation::CGPoint::new(0.0, 0.0),
+            objc2_core_foundation::CGSize::new(640.0, 360.0),
+        );
+        let raw: *mut AnyObject = msg_send![allocated, initWithFrame: frame];
+        let view: Retained<AnyObject> = match Retained::from_raw(raw) {
+            Some(view) => view,
+            None => return 0,
+        };
+
+        let _: () = msg_send![&*view, setPlayer: player];
+        // AVPlayerViewControlsStyleFloating = 2, matching Photos on macOS.
+        let _: () = msg_send![&*view, setControlsStyle: 2i64];
+        let _: () = msg_send![&*view, setShowsFullScreenToggleButton: false];
+        let _: () = msg_send![&*view, setAllowsPictureInPicturePlayback: true];
+
+        let nsview: Retained<NSView> = Retained::cast_unchecked(view);
+        super::register_widget(nsview)
+    }
+}
+
+pub fn set_playing(handle: i64, playing: bool) {
+    let Some(view) = super::get_widget(handle) else {
+        return;
+    };
+
+    unsafe {
+        let Some(player_view_class) = AnyClass::get(c"AVPlayerView") else {
+            return;
+        };
+        let is_player_view: bool = msg_send![&*view, isKindOfClass: player_view_class];
+        if !is_player_view {
+            return;
+        }
+        let player: *mut AnyObject = msg_send![&*view, player];
+        if player.is_null() {
+            return;
+        }
+        if playing {
+            let _: () = msg_send![player, play];
+        } else {
+            let _: () = msg_send![player, pause];
+        }
+    }
+}
