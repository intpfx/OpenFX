diff --git a/crates/perry-ext-http/src/client_dispatch_ext.rs b/crates/perry-ext-http/src/client_dispatch_ext.rs
new file mode 100644
index 0000000..5326336
--- /dev/null
+++ b/crates/perry-ext-http/src/client_dispatch_ext.rs
@@ -0,0 +1,134 @@
+//! Runtime handle-dispatch extension for external HTTP client requests.
+//!
+//! `ClientRequestHandle` values live in perry-ffi's external handle registry,
+//! while the primary stdlib dispatcher also probes several independent
+//! small-integer registries. Once another subsystem allocates the same numeric
+//! id, a generic `req.end()` can be claimed before the HTTP-client arm is
+//! reached. Registering an authoritative extension keeps external client
+//! handles on their owning dispatch surface.
+
+use std::sync::Once;
+
+extern "C" {
+    fn js_register_handle_method_dispatch_extension(
+        f: unsafe extern "C" fn(i64, *const u8, usize, *const f64, usize, *mut f64) -> i32,
+    );
+    fn js_register_handle_property_dispatch_extension(
+        f: unsafe extern "C" fn(i64, *const u8, usize, *mut f64) -> i32,
+    );
+}
+
+pub(crate) fn ensure_dispatch_extensions_registered() {
+    static REGISTER: Once = Once::new();
+    REGISTER.call_once(|| unsafe {
+        js_register_handle_method_dispatch_extension(client_request_method_dispatch_ext);
+        js_register_handle_property_dispatch_extension(client_request_property_dispatch_ext);
+    });
+}
+
+#[inline]
+unsafe fn name_str<'a>(ptr: *const u8, len: usize) -> &'a str {
+    if ptr.is_null() || len == 0 {
+        ""
+    } else {
+        std::str::from_utf8(std::slice::from_raw_parts(ptr, len)).unwrap_or("")
+    }
+}
+
+fn is_client_request_method(name: &str) -> bool {
+    matches!(
+        name,
+        "end"
+            | "write"
+            | "setHeader"
+            | "setTimeout"
+            | "listenerCount"
+            | "getHeader"
+            | "hasHeader"
+            | "removeHeader"
+            | "getHeaderNames"
+            | "getHeaders"
+            | "getRawHeaderNames"
+            | "abort"
+            | "destroy"
+            | "flushHeaders"
+            | "cork"
+            | "uncork"
+            | "setNoDelay"
+            | "setSocketKeepAlive"
+            | "on"
+            | "once"
+            | "addListener"
+            | "prependListener"
+            | "removeListener"
+            | "off"
+            | "removeAllListeners"
+    )
+}
+
+fn is_client_request_property(name: &str) -> bool {
+    is_client_request_method(name)
+        || matches!(
+            name,
+            "method"
+                | "protocol"
+                | "host"
+                | "path"
+                | "aborted"
+                | "destroyed"
+                | "finished"
+                | "reusedSocket"
+                | "maxHeadersCount"
+                | "writableEnded"
+                | "writableFinished"
+                | "socket"
+                | "connection"
+                | "constructor"
+        )
+}
+
+unsafe extern "C" fn client_request_method_dispatch_ext(
+    handle: i64,
+    method_ptr: *const u8,
+    method_len: usize,
+    args_ptr: *const f64,
+    args_len: usize,
+    out: *mut f64,
+) -> i32 {
+    let name = name_str(method_ptr, method_len);
+    if !is_client_request_method(name)
+        || crate::client_request_surface::js_ext_http_client_request_is_handle(handle) == 0
+    {
+        return 0;
+    }
+    let value = crate::client_request_surface::js_ext_http_client_request_dispatch_method(
+        handle, method_ptr, method_len, args_ptr, args_len,
+    );
+    if !out.is_null() {
+        *out = value;
+    }
+    1
+}
+
+unsafe extern "C" fn client_request_property_dispatch_ext(
+    handle: i64,
+    property_ptr: *const u8,
+    property_len: usize,
+    out: *mut f64,
+) -> i32 {
+    let name = name_str(property_ptr, property_len);
+    if !is_client_request_property(name)
+        || crate::client_request_surface::js_ext_http_client_request_is_handle(handle) == 0
+    {
+        return 0;
+    }
+    let value = crate::client_request_surface::js_ext_http_client_request_dispatch_property(
+        handle,
+        property_ptr,
+        property_len,
+    );
+    if !out.is_null() {
+        *out = value;
+    }
+    1
+}
