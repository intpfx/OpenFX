@@ -255,0 +256,68 @@ pub(crate) static NEXT_CONNECTION_ID: AtomicU64 = AtomicU64::new(1);
+// The HTTP pump snapshots typed handle ids before it mutates server state. A
+// fresh Vec for that snapshot on every 8ms macOS tick made the allocator keep
+// acquiring slabs even when the same single listening server was the only
+// handle. Keep one recyclable buffer instead. The Option is checked out while
+// callbacks run so a re-entrant pump can fall back to its own Vec rather than
+// deadlocking on this mutex; the buffer with the larger capacity wins when
+// both invocations return it.
+static HTTP_PUMP_HANDLE_SCRATCH: Mutex<Option<Vec<i64>>> = Mutex::new(Some(Vec::new()));
+
+fn take_recycled_handle_buffer(scratch: &Mutex<Option<Vec<i64>>>) -> Vec<i64> {
+    scratch
+        .lock()
+        .ok()
+        .and_then(|mut buffer| buffer.take())
+        .unwrap_or_default()
+}
+
+fn return_recycled_handle_buffer(scratch: &Mutex<Option<Vec<i64>>>, mut handles: Vec<i64>) {
+    handles.clear();
+    if let Ok(mut buffer) = scratch.lock() {
+        let replace = buffer
+            .as_ref()
+            .map(|current| handles.capacity() > current.capacity())
+            .unwrap_or(true);
+        if replace {
+            *buffer = Some(handles);
+        }
+    }
+}
+
+fn snapshot_http_pump_handles<T>() -> Vec<i64>
+where
+    T: Send + Sync + 'static,
+{
+    let mut handles = take_recycled_handle_buffer(&HTTP_PUMP_HANDLE_SCRATCH);
+    handles.clear();
+    perry_ffi::iter_handle_ids_of::<T, _>(|id| handles.push(id));
+    handles
+}
+
+fn recycle_http_pump_handles(handles: Vec<i64>) {
+    return_recycled_handle_buffer(&HTTP_PUMP_HANDLE_SCRATCH, handles);
+}
+
+#[cfg(test)]
+mod pump_handle_scratch_tests {
+    use super::{return_recycled_handle_buffer, take_recycled_handle_buffer};
+    use std::sync::Mutex;
+
+    #[test]
+    fn returns_the_largest_checked_out_capacity_for_reuse() {
+        let scratch = Mutex::new(Some(Vec::new()));
+        let mut outer = take_recycled_handle_buffer(&scratch);
+        outer.reserve(32);
+        let outer_capacity = outer.capacity();
+
+        // A re-entrant pump checks out while the primary buffer is in use.
+        let mut nested = take_recycled_handle_buffer(&scratch);
+        nested.reserve(4);
+        return_recycled_handle_buffer(&scratch, nested);
+        return_recycled_handle_buffer(&scratch, outer);
+
+        let reused = take_recycled_handle_buffer(&scratch);
+        assert!(reused.is_empty());
+        assert!(reused.capacity() >= outer_capacity);
+    }
+}
