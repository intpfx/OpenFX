+/// Capture the app-owned content view without Screen Recording permission.
+/// `CGWindowListCreateImage` returns null on privacy-restricted macOS hosts,
+/// while AppKit can still render a process-owned view into a bitmap safely.
+unsafe fn capture_main_view_png(out_len: *mut usize) -> *mut u8 {
+    let content_view: *mut AnyObject = crate::app::APPS.with(|apps| {
+        apps.borrow()
+            .first()
+            .map(|app| msg_send![&*app.window, contentView])
+            .unwrap_or(std::ptr::null_mut())
+    });
+    if content_view.is_null() {
+        return std::ptr::null_mut();
+    }
+
+    let bounds: CGRect = msg_send![content_view, bounds];
+    let bitmap: *mut AnyObject =
+        msg_send![content_view, bitmapImageRepForCachingDisplayInRect: bounds];
+    if bitmap.is_null() {
+        return std::ptr::null_mut();
+    }
+    let _: () = msg_send![content_view, cacheDisplayInRect: bounds, toBitmapImageRep: bitmap];
+
+    let empty_dict_cls = AnyClass::get(c"NSDictionary").unwrap();
+    let empty_dict: Retained<AnyObject> = msg_send![empty_dict_cls, dictionary];
+    let png_data: *const AnyObject =
+        msg_send![bitmap, representationUsingType: 4_usize, properties: &*empty_dict];
+    if png_data.is_null() {
+        return std::ptr::null_mut();
+    }
+
+    let length: usize = msg_send![png_data, length];
+    let bytes: *const u8 = msg_send![png_data, bytes];
+    if length == 0 || bytes.is_null() {
+        return std::ptr::null_mut();
+    }
+
+    let buf = libc::malloc(length) as *mut u8;
+    if buf.is_null() {
+        return std::ptr::null_mut();
+    }
+    std::ptr::copy_nonoverlapping(bytes, buf, length);
+    *out_len = length;
+    buf
+}
