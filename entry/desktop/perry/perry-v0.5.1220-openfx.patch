@@ -6,0 +7,41 @@ use super::*;
+lazy_static! {
+    static ref COMPLETED_HTTP_HANDLES: Mutex<Vec<(Handle, Handle)>> = Mutex::new(Vec::new());
+}
+
+fn schedule_completed_http_handles(request_handle: Handle) {
+    let incoming_handle =
+        with_handle_mut::<ClientRequestHandle, _, _>(request_handle, |req| req.incoming_handle)
+            .unwrap_or(0);
+    let mut pending = COMPLETED_HTTP_HANDLES
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    if !pending
+        .iter()
+        .any(|(pending_request, _)| *pending_request == request_handle)
+    {
+        pending.push((request_handle, incoming_handle));
+    }
+}
+
+/// Release client handles one pump turn after their terminal callbacks.
+///
+/// Keeping both handles registered through the remainder of the terminal turn
+/// lets callback-created microtasks and zero-delay timers observe the same
+/// request/response values. `drop_handle` then parks each numeric id in
+/// perry-ffi's quarantine before it can be reused, preventing same-tick ABA.
+pub(crate) fn finalize_completed_http_handles() {
+    let completed = {
+        let mut pending = COMPLETED_HTTP_HANDLES
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        std::mem::take(&mut *pending)
+    };
+    for (request_handle, incoming_handle) in completed {
+        client_request_surface::remove_state(request_handle);
+        if incoming_handle != 0 {
+            perry_ffi::drop_handle(incoming_handle);
+        }
+        perry_ffi::drop_handle(request_handle);
+    }
+}
