     WAIT_DRIVER_FAST.store(fast_ptr, Ordering::Release);
+    let drive_ptr = drive.map(|f| f as *mut ()).unwrap_or(std::ptr::null_mut());
+    WAIT_DRIVER_DRIVE.store(drive_ptr, Ordering::Release);
     let sleep_ptr = sleep.map(|f| f as *mut ()).unwrap_or(std::ptr::null_mut());
