+/// Drive one bounded pending-work slice when a stdlib driver is registered.
+/// Unlike the event-loop sleep callback, this path does not end early on an
+/// already-set notification flag. Native UI hosts use it to advance the
+/// current-thread reactor from their resident event loop; UI-only programs
+/// keep linking against perry-runtime alone and receive a cheap no-op.
+#[no_mangle]
+pub extern "C" fn js_drive_registered_pending(budget_ms: u64) -> i32 {
+    let p = WAIT_DRIVER_DRIVE.load(Ordering::Acquire);
+    if p.is_null() {
+        return 0;
+    }
+    let f: extern "C" fn(u64) = unsafe { std::mem::transmute(p) };
+    f(budget_ms);
+    1
+}
+
