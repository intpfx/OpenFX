+/// Resolve packaged tray assets before falling back to the caller's path.
+/// A macOS app executable lives in `Contents/MacOS`; its resources are in the
+/// sibling `Contents/Resources` directory. Standalone Perry binaries resolve
+/// assets next to the executable so launch cwd never changes icon behaviour.
+fn resolve_resource_path(path: &str) -> PathBuf {
+    let requested = Path::new(path);
+    if requested.is_absolute() {
+        return requested.to_path_buf();
+    }
+
+    if let Ok(executable) = std::env::current_exe() {
+        if let Some(executable_directory) = executable.parent() {
+            if let Some(contents_directory) = executable_directory
+                .parent()
+                .filter(|directory| directory.file_name().is_some_and(|name| name == "Contents"))
+            {
+                let bundled = contents_directory.join("Resources").join(requested);
+                if bundled.is_file() {
+                    return bundled;
+                }
+            }
+
+            let adjacent = executable_directory.join(requested);
+            if adjacent.is_file() {
+                return adjacent;
+            }
+        }
+    }
+
+    requested.to_path_buf()
+}
