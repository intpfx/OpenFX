{
  "name": "@openfx/web",
  "exports": "./src/main.tsx",
  "publish": false,
  "tasks": {
    "prepare:hlc": "deno run --no-config --allow-read=../domains/hlc --allow-write=.hlc-public ../domains/hlc/tools/build-display-app.ts",
    "prepare:media-player": "deno run --no-config -A ../domains/media-player/openfx/build.ts",
    "prepare": "deno task prepare:hlc && deno task prepare:media-player",
    "dev:client": "deno run --config deno.json --lock ../deno.lock --frozen -A tools/vite.ts dev",
    "dev:server": "deno run --config deno.json --lock ../deno.lock --frozen -A npm:nitropack@2.13.4 dev",
    "dev": "deno task prepare && deno run --config deno.json --lock ../deno.lock --frozen -A npm:concurrently@9.2.1 -k -n client,server -c blue,green \"deno task dev:client\" \"deno task dev:server\"",
    "build": "deno run --config deno.json --lock ../deno.lock --frozen -A tools/build-with-metadata.ts",
    "preview": "deno task build && cd .output && deno run --unstable-kv -A server/index.ts",
    "test": "deno test --allow-env --allow-read=src/App.tsx,src/file-library/FileLibraryHomepage.tsx,src/file-library/file-library.css,src/styles.css,deno.json,nitro.config.ts,vite.config.ts,public/map-poster/tokyo-japanese-ink.webp,public/site.webmanifest,public/sw.js,../domains/hlc/public/hlc,../deno.json,index.html,public/theme-bootstrap.js tests"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@/": "./",
    "@phosphor-icons/react": "npm:@phosphor-icons/react@^2.1.10",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.4",
    "@voidzero-dev/vite-plus-core": "npm:@voidzero-dev/vite-plus-core@0.1.21",
    "heic-to/next": "npm:heic-to@1.5.2/next",
    "vite-plus": "npm:vite-plus@0.1.21",
    "h3": "npm:h3@^1.15.11",
    "nitropack": "npm:nitropack@^2.13.4",
    "nitropack/runtime": "npm:nitropack@^2.13.4/runtime",
    "nitropack/": "npm:nitropack@^2.13.4/",
    "opfs-tools": "npm:opfs-tools@0.7.4",
    "react": "npm:react@^19.1.0",
    "react-dom": "npm:react-dom@^19.1.0",
    "react-dom/": "npm:react-dom@^19.1.0/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext",
      "deno.ns",
      "deno.unstable"
    ]
  }
}
