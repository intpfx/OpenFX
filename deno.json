{
  "description": "OpenFX Deno monorepo for VitePlus, React, and Nitro web applications.",
  "license": "Apache-2.0",
  "publish": false,
  "nodeModulesDir": "auto",
  "workspace": [
    "./entry/web",
    "./domains/e"
  ],
  "tasks": {
    "fmt": "deno fmt .",
    "lint": "deno lint .",
    "guard:deno-only": "deno run -A ./tools/guard-deno-only.ts",
    "test": "deno test --allow-env --allow-read=entry/web/src/App.tsx,entry/web/src/file-library/FileLibraryHomepage.tsx,entry/web/src/file-library/file-library.css,entry/web/src/styles.css,entry/web/deno.json,entry/web/nitro.config.ts,entry/web/vite.config.ts,entry/web/public/map-poster/tokyo-japanese-ink.webp,entry/web/public/site.webmanifest,entry/web/public/sw.js,domains/hlc/public/hlc,deno.json,entry/web/index.html,entry/web/public/theme-bootstrap.js domains/e/tests entry/web/tests domains/_shared/tests",
    "check": "deno fmt --check . && deno lint . && deno task guard:deno-only && deno test --allow-env --allow-read=entry/web/src/App.tsx,entry/web/src/file-library/FileLibraryHomepage.tsx,entry/web/src/file-library/file-library.css,entry/web/src/styles.css,entry/web/deno.json,entry/web/nitro.config.ts,entry/web/vite.config.ts,entry/web/public/map-poster/tokyo-japanese-ink.webp,entry/web/public/site.webmanifest,entry/web/public/sw.js,domains/hlc/public/hlc,deno.json,entry/web/index.html,entry/web/public/theme-bootstrap.js domains/e/tests entry/web/tests domains/_shared/tests",
    "web:dev": "deno task --config entry/web/deno.json dev",
    "web:build": "deno task --config entry/web/deno.json build",
    "web:preview": "deno task --config entry/web/deno.json preview"
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "entry/web/public/pdq/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-unversioned-import"
      ]
    },
    "exclude": [
      "domains/wanone/",
      "domains/chinagas-wms-qrcode/",
      "entry/web/public/bewlyscript/",
      "entry/web/src/",
      "domains/_shared/opfs-finder.ts",
      "domains/_shared/island-notice.ts",
      "domains/_shared/idb-engine.ts",
      "domains/_shared/ffmpeg-pipeline.ts",
      "domains/_shared/opfs-engine.ts",
      "domains/costing-assistant/",
      "domains/finlyzer/",
      "domains/hlc/",
      "domains/BewlyScript/",
      "domains/media-player/",
      "entry/web/public/pdq/"
    ]
  },
  "exclude": [
    "dist",
    "domains/gasmap",
    "domains/costing-assistant/",
    "domains/finlyzer/",
    "entry/web/public/bewlyscript/",
    "domains/hlc/",
    "domains/BewlyScript/",
    "domains/media-player/",
    "entry/web/public/pdq/",
    ".sisyphus"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.4",
    "h3": "npm:h3@^1.15.11",
    "nitropack": "npm:nitropack@^2.13.4",
    "nitropack/runtime": "npm:nitropack@^2.13.4/runtime",
    "nitropack/": "npm:nitropack@^2.13.4/",
    "opfs-tools": "npm:opfs-tools@0.7.4",
    "pdq-wasm": "npm:pdq-wasm@0.3.9",
    "react": "npm:react@^19.1.0",
    "react-dom": "npm:react-dom@^19.1.0",
    "react-dom/": "npm:react-dom@^19.1.0/"
  },
  "deploy": {
    "org": "universes"
  }
}
