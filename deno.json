{
  "description": "OpenFX Deno monorepo for VitePlus, React, and Nitro web applications.",
  "license": "Apache-2.0",
  "publish": false,
  "nodeModulesDir": "auto",
  "workspace": [
    "./web",
    "./domains/e"
  ],
  "tasks": {
    "fmt": "deno fmt .",
    "fmt:check": "deno fmt --check .",
    "lint": "deno lint .",
    "guard:deno-only": "deno run -A ./tools/guard-deno-only.ts",
    "test:e": "deno test --allow-env domains/e/tests",
    "test:web": "deno task --config web/deno.json test",
    "test": "deno task test:e && deno task test:web",
    "check": "deno task fmt:check && deno task lint && deno task guard:deno-only && deno task test",
    "prepare": "deno task --config web/deno.json prepare",
    "dev": "deno task --config web/deno.json dev",
    "dev:client": "deno task --config web/deno.json dev:client",
    "dev:server": "deno task --config web/deno.json dev:server",
    "build": "deno task --config web/deno.json build",
    "preview": "deno task --config web/deno.json preview",
    "deploy": "deno deploy ."
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "web/public/pdq/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-unversioned-import"
      ]
    },
    "exclude": [
      "domains/wanone/",
      "domains/chinagas-wms-qrcode/",
      "web/public/bewlyscript/",
      "web/src/",
      "domains/costing-assistant/",
      "domains/finlyzer/",
      "domains/hlc/",
      "domains/BewlyScript/",
      "domains/media-player/",
      "web/public/pdq/"
    ]
  },
  "exclude": [
    "dist",
    "domains/gasmap",
    "domains/costing-assistant/",
    "domains/finlyzer/",
    "web/public/bewlyscript/",
    "domains/hlc/",
    "domains/BewlyScript/",
    "domains/media-player/",
    "web/public/pdq/",
    ".sisyphus"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.4",
    "h3": "npm:h3@^1.15.11",
    "nitropack": "npm:nitropack@^2.13.4",
    "nitropack/runtime": "npm:nitropack@^2.13.4/runtime",
    "nitropack/": "npm:nitropack@^2.13.4/",
    "opfs-tools": "npm:opfs-tools@0.7.4",
    "pdq-wasm": "npm:pdq-wasm@0.3.9",
    "react": "npm:react@^19.1.0",
    "react-dom": "npm:react-dom@^19.1.0",
    "react-dom/": "npm:react-dom@^19.1.0/"
  },
  "deploy": {
    "org": "universes",
    "app": "openfx",
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "web/.output/server/index.ts",
      "cwd": "."
    },
    "exclude": [
      ".git/",
      ".worktrees/",
      "graphify-out/",
      "node_modules/",
      "web/.client-dist/",
      "web/.hlc-public/",
      "web/.nitro/",
      "web/.output/",
      "web/.vite/"
    ]
  }
}
