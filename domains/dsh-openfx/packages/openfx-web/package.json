{
  "name": "dsh-openfx-web",
  "description": "One-install OpenFX web experience bundle for DeepSeek Harness.",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "build": "node ../../shared/build-meta.mjs",
    "prepare": "pnpm run build",
    "pack:check": "pnpm pack --dry-run"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "dsh-ambient-theme": "workspace:^",
    "dsh-conversation-browser": "workspace:^",
    "dsh-design-annotations": "workspace:^",
    "dsh-usage-balance": "workspace:^",
    "dsh-workspace-shell": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intpfx/OpenFX.git",
    "directory": "domains/dsh-openfx/packages/openfx-web"
  }
}
